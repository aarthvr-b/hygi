# Copy to .env.local for local `npm run dev` against a hosted Supabase project.
# For local dev/test against the harness, `supabase start` prints these values
# (or run `npx supabase status`) — no hosted project needed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the test harness to create/delete test users — never
# exposed to the browser. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
